#!/bin/bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

PYTHON_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
    if command -v python >/dev/null 2>&1; then
        PYTHON_BIN="python"
    elif command -v py >/dev/null 2>&1; then
        PYTHON_BIN="py -3"
    fi
fi

echo "🛡️ [PRE-COMMIT HOOK] Ejecutando Lazymark Quality Harness con $PYTHON_BIN..."
$PYTHON_BIN "${REPO_ROOT}/harness/validate_project.py"
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "❌ [ERROR] El commit fue cancelado debido a fallos detectados por el Harness."
    echo "👉 Corrige los errores señalados arriba antes de commitear."
    exit 1
fi

echo "✅ [SUCCESS] Harness verificado. Procediendo con el commit."
exit 0
